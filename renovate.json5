{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>farcloser/limen#v0.1.1",
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.13.0",
  ],
  // Supply-chain cooldown: wait before proposing a bump. Doubles as protection
  // against the race where a release tag exists but its assets aren't uploaded yet.
  minimumReleaseAge: "3 days",
  // Stated explicitly: `enabled: true` here is what re-enables `// indirect`
  // Go modules for alert-driven fix PRs; the gomod manager disables them
  // otherwise.
  vulnerabilityAlerts: {
    enabled: true,
  },
  // `just do lint commits` enforces DCO on every PR range, bot commits included.
  commitBody: "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  // The update-aqua-checksum workflow pushes a fix-up commit onto Renovate's
  // branches; without this, Renovate treats the branch as human-modified and
  // stops rebasing it.
  gitIgnoredAuthors: [
    "300983632+limen-ci-farcloser[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com",
  ],
  customManagers: [
    // The guest kernel pin in the Justfile. Renovate proposes the tag bump;
    // guest_kernel_sha256 must be updated by hand in the same PR (fetch-kernel
    // fails loudly with the actual digest until it is) — the human step is the
    // point: a kernel bump is a reviewed supply-chain change.
    {
      customType: "regex",
      managerFilePatterns: ["/^Justfile$/"],
      matchStrings: ['guest_kernel_tag := "(?<currentValue>[^"]+)"'],
      depNameTemplate: "farcloser/ossein-kernel",
      datasourceTemplate: "github-releases",
    },
  ],
}
